<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.presire.qsnapper.Operations">
    <!--
      Restore exclusion gate.
      While a committed restore plan is running (from authorization and mount
      until the plan reaches a terminal state), every non-restore method that
      goes through the service's authorization gate is rejected with the D-Bus
      error

        com.presire.qsnapper.Error.RestoreInProgress
        message: "A restore is in progress"

      The message is a fixed string and never contains a config name, path or
      snapshot number. The check runs before Polkit is consulted and again
      immediately before the method body runs, so a restore that starts while
      an authorization prompt is pending still blocks the method.
      Exempt: ListConfigs and IsConfigured (they only read the static config
      list and never touch the shared Snapper instance, comparison cache or
      mount state) and the restore plan methods below (they keep their own
      single-running-plan exclusion).
      New non-restore methods are gated by default.

      Settings and timers.
      GetConfig returns only the editable keys plus SUBVOLUME, FSTYPE and
      QGROUP. WriteSnapperConfig accepts only the editable keys, writes the
      config file of that name directly and never enables or disables a
      systemd timer. GetTimerStates and SetTimerEnabled accept only the fixed
      Snapper timer units (snapper-timeline.timer, snapper-cleanup.timer,
      snapper-boot.timer); the unit file state and the active state are
      reported separately and the timers are shared by all configs.
      Only one timer operation runs at a time; a second one is rejected with
      org.freedesktop.DBus.Error.LimitsExceeded. SetTimerEnabled returns true
      only when the state read back from systemd matches the request.

      Configurations and bulk deletion.
      CreateConfig, DeleteConfig and DeleteSnapshots are forwarded to snapperd
      (org.opensuse.Snapper) after the service has re-checked the state after
      authorization; the result is read back before replying. The root
      configuration is never created or deleted here. While one of them is
      running, every method that takes a config name, every gated method and
      the start of a restore are rejected with

        com.presire.qsnapper.Error.OperationInProgress

      If the result cannot be confirmed (reply deadline, snapperd exit) the
      error is com.presire.qsnapper.Error.OutcomeUnknown and the caller must
      reload. DeleteConfig and DeleteSnapshots are rejected with
      com.presire.qsnapper.Error.RestorePlanPending while an unfinished
      restore plan exists for the config, and with
      com.presire.qsnapper.Error.SnapshotListOutdated when snapperd does not
      know every snapshot yet. DeleteSnapshots accepts numbers greater than
      zero, removes duplicates, rejects more than 100 unique numbers (1000 raw)
      and returns the numbers confirmed as deleted (a shorter list means a
      partial deletion).
      GetFilesystemUsage and ListSubvolumes are read-only and return CSV text;
      the subvolume list is truncated by count, size and time and says so in
      its first line.
    -->
    <method name="ListConfigs">
      <arg name="configs" type="as" direction="out"/>
    </method>
    <method name="ListSnapshots">
      <arg name="configName" type="s" direction="in"/>
      <arg name="snapshots" type="s" direction="out"/>
    </method>
    <method name="CreateSnapshot">
      <arg name="configName" type="s" direction="in"/>
      <arg name="type" type="s" direction="in"/>
      <arg name="description" type="s" direction="in"/>
      <arg name="preNumber" type="i" direction="in"/>
      <arg name="cleanup" type="s" direction="in"/>
      <arg name="userdata" type="a{ss}" direction="in"/>
      <arg name="important" type="b" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QMap&lt;QString,QString&gt;"/>
      <arg name="snapshotData" type="s" direction="out"/>
    </method>
    <method name="ModifySnapshot">
      <arg name="configName" type="s" direction="in"/>
      <arg name="number" type="i" direction="in"/>
      <arg name="description" type="s" direction="in"/>
      <arg name="cleanup" type="s" direction="in"/>
      <arg name="userdata" type="a{ss}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QMap&lt;QString,QString&gt;"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="DeleteSnapshot">
      <arg name="configName" type="s" direction="in"/>
      <arg name="number" type="i" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="RollbackSnapshot">
      <arg name="configName" type="s" direction="in"/>
      <arg name="number" type="i" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="GetFileChanges">
      <arg name="configName" type="s" direction="in"/>
      <arg name="snapshotNumber" type="i" direction="in"/>
      <arg name="changes" type="s" direction="out"/>
    </method>
    <method name="GetFileChangesBetween">
      <arg name="configName" type="s" direction="in"/>
      <arg name="number1" type="i" direction="in"/>
      <arg name="number2" type="i" direction="in"/>
      <arg name="changes" type="s" direction="out"/>
    </method>
    <method name="GetFileDiffAndDetails">
      <arg name="configName" type="s" direction="in"/>
      <arg name="snapshotNumber" type="i" direction="in"/>
      <arg name="filePath" type="s" direction="in"/>
      <arg name="result" type="s" direction="out"/>
    </method>
    <method name="GetFileDiffBetween">
      <arg name="configName" type="s" direction="in"/>
      <arg name="number1" type="i" direction="in"/>
      <arg name="number2" type="i" direction="in"/>
      <arg name="filePath" type="s" direction="in"/>
      <arg name="result" type="s" direction="out"/>
    </method>
    <!--
      Staged restore (single-authorization path).
      Pre-freeze methods (BeginRestorePlan, StageRestoreEntries) only collect
      bounded chunks; no Polkit authorization happens until CommitRestorePlan
      freezes the plan and authorizes exactly once. Post-freeze methods
      (ContinueRestorePlan, GetRestorePlanStatus, CancelRestorePlan) accept
      ONLY a manifest identifier — never a path, change type, config name,
      snapshot number, or restore mode — so a frozen plan cannot be mutated
      after the single authorization. restoreMode is the string "yast" or
      "direct".
      counterpartSnapshotNumber is the comparison counterpart of the restore
      SOURCE (snapshotNumber): 0 means "the current system", a positive value
      must differ from snapshotNumber. The server reconstructs the
      authoritative comparison from (snapshotNumber, counterpartSnapshotNumber)
      at commit time and re-validates every staged entry against it.
      statusCsv field order is a PUBLIC SUBSET of ManifestStatus in
      restoremanifest.h (the internal counterpartSnapshotNumber field is
      intentionally not exposed; positional parsers must not be shifted):
        id, state, totalEntries, cursor, processed, mode, configName,
        snapshotNumber, lastError
    -->
    <method name="BeginRestorePlan">
      <arg name="configName" type="s" direction="in"/>
      <arg name="snapshotNumber" type="i" direction="in"/>
      <arg name="counterpartSnapshotNumber" type="i" direction="in"/>
      <arg name="restoreMode" type="s" direction="in"/>
      <arg name="manifestId" type="s" direction="out"/>
    </method>
    <method name="StageRestoreEntries">
      <arg name="manifestId" type="s" direction="in"/>
      <arg name="filePaths" type="as" direction="in"/>
      <arg name="changeTypes" type="as" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="CommitRestorePlan">
      <arg name="manifestId" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="ContinueRestorePlan">
      <arg name="manifestId" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="GetRestorePlanStatus">
      <arg name="manifestId" type="s" direction="in"/>
      <arg name="statusCsv" type="s" direction="out"/>
    </method>
    <method name="CancelRestorePlan">
      <arg name="manifestId" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="IsConfigured">
      <arg name="configured" type="b" direction="out"/>
    </method>
    <method name="WriteSnapperConfig">
      <arg name="configName" type="s" direction="in"/>
      <arg name="settings" type="a{ss}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QMap&lt;QString,QString&gt;"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="SetupQuota">
      <arg name="configName" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="GetConfig">
      <arg name="configName" type="s" direction="in"/>
      <arg name="settings" type="a{ss}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QMap&lt;QString,QString&gt;"/>
    </method>
    <method name="GetTimerStates">
      <arg name="states" type="a{s(ss)}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="SnapperTimerStateMap"/>
    </method>
    <method name="SetTimerEnabled">
      <arg name="unit" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="CreateConfig">
      <arg name="configName" type="s" direction="in"/>
      <arg name="subvolume" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="DeleteConfig">
      <arg name="configName" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="DeleteSnapshots">
      <arg name="configName" type="s" direction="in"/>
      <arg name="numbers" type="au" direction="in"/>
      <arg name="deleted" type="au" direction="out"/>
    </method>
    <method name="GetFilesystemUsage">
      <arg name="configName" type="s" direction="in"/>
      <arg name="usage" type="s" direction="out"/>
    </method>
    <method name="ListSubvolumes">
      <arg name="configName" type="s" direction="in"/>
      <arg name="subvolumes" type="s" direction="out"/>
    </method>
    <signal name="restorePlanProgress">
      <arg name="manifestId" type="s"/>
      <arg name="current" type="i"/>
      <arg name="total" type="i"/>
    </signal>
    <signal name="restorePlanFinished">
      <arg name="manifestId" type="s"/>
      <arg name="terminalState" type="s"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
