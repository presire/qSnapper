## <summary>Btrfs/Snapperのスナップショットを管理するQt6/QMLのGUIアプリケーション</summary>

########################################
# 外部のポリシーモジュールへ公開するインターフェース
#
# 他のポリシーモジュールがqSnapperのドメイン遷移・ロールの許可・D-Bus通信を許可するために使う
# qsnapper_conf_tなどの専用の型は.teで宣言していないため
# 専用の型を参照するインターフェースは公開しない
# 宣言の無い型を参照すると、利用するモジュールのビルドが失敗するため
########################################

########################################
## <summary>
##	qsnapperをqsnapperドメインで実行する
## </summary>
## <param name="domain">
##	<summary>
##	ドメイン遷移を許可するドメイン
##	</summary>
## </param>
#
interface(`qsnapper_domtrans',`
	gen_require(`
		type qsnapper_t, qsnapper_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, qsnapper_exec_t, qsnapper_t)
')

########################################
## <summary>
##	qsnapperをqsnapperドメインで実行し、指定したロールにqsnapperドメインを許可する
## </summary>
## <param name="domain">
##	<summary>
##	ドメイン遷移を許可するドメイン
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	アクセスを許可するロール
##	</summary>
## </param>
#
interface(`qsnapper_run',`
	gen_require(`
		type qsnapper_t;
		attribute_role qsnapper_roles;
	')

	qsnapper_domtrans($1)
	roleattribute $2 qsnapper_roles;
')

########################################
## <summary>
##	qsnapperとのD-Busメッセージの送受信を許可する
## </summary>
## <param name="domain">
##	<summary>
##	通信を許可するドメイン
##	</summary>
## </param>
#
interface(`qsnapper_dbus_chat',`
	gen_require(`
		type qsnapper_t;
		class dbus send_msg;
	')

	allow $1 qsnapper_t:dbus send_msg;
	allow qsnapper_t $1:dbus send_msg;
')

########################################
## <summary>
##	qsnapperのD-Busサービスをqsnapper_dbusドメインで実行する
## </summary>
## <param name="domain">
##	<summary>
##	ドメイン遷移を許可するドメイン
##	</summary>
## </param>
#
interface(`qsnapper_dbus_domtrans',`
	gen_require(`
		type qsnapper_dbus_t, qsnapper_dbus_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, qsnapper_dbus_exec_t, qsnapper_dbus_t)
')

########################################
## <summary>
##	qsnapperのD-Busサービスとのメッセージの送受信を許可する
## </summary>
## <param name="domain">
##	<summary>
##	通信を許可するドメイン
##	</summary>
## </param>
#
interface(`qsnapper_dbus_service_chat',`
	gen_require(`
		type qsnapper_dbus_t;
		class dbus send_msg;
	')

	allow $1 qsnapper_dbus_t:dbus send_msg;
	allow qsnapper_dbus_t $1:dbus send_msg;
')

